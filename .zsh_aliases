#===================ALIASES====================
# Example aliases
alias zshconfig="nvim ~/.zshrc"
alias ohmyzsh="nvim ~/.oh-my-zsh"
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gclone='git clone'
update() {
  command -v brew >/dev/null 2>&1 && { brew update && brew upgrade && brew cleanup; }
  command -v apt >/dev/null 2>&1 && { sudo apt update && apt list --upgradeable && sudo apt upgrade -y && sudo apt autoremove -y; }
  command -v flatpak >/dev/null 2>&1 && flatpak update -y
  command -v snap >/dev/null 2>&1 && sudo snap refresh
}
alias icat="kitty +kitten icat"
alias v="nvim"
alias integrated="sudo prime-select intel && sleep 45 && reboot"
alias nvidia="sudo prime-select nvidia && sleep 45 && reboot"
alias vpn='sudo cyberghostvpn --connect --country-code US'
alias vpnstop='sudo cyberghostvpn --stop'
alias vpnstat='cyberghostvpn --status'
alias license='mklicense'
alias synology='sudo mount.cifs //192.168.1.15/home /mnt/share -o credentials=$HOME/.ssh/credentials,uid=1000,gid=1000'
alias spicetify="$HOME/spicetify-cli/spicetify"
alias spicereload='spicetify backup apply enable-devtool'
alias config='/usr/bin/git --git-dir=$DOTFILES/ --work-tree=$HOME'
alias npmreinstall='rm -rf node_modules/ && npm install'
alias gstat='git status'
alias brew='env PATH="${PATH//$(pyenv root)\/shims:/}" brew'
alias dcr="docker compose run"
alias dcd="docker compose down"
alias dcu="docker compose up"
alias dcb="docker compose build"
alias lvim="$HOME/.local/bin/lvim"
