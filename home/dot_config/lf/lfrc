set preview true
set hidden true
set drawbox true
set icons true

# define a custom 'open' command
# This command is called when current file is not a directory. You may want to
# use either file extensions and/or mime types here. Below uses an editor for
# text files and a file opener for the rest.

# `setsid` is util-linux; macOS has never shipped it and has no BSD
# equivalent. Since stderr went to /dev/null too, every non-text open on macOS
# silently did nothing — which defeats the point of `export OPENER=open` in
# .zshrc. macOS's `open` detaches on its own, so setsid isn't needed there.
# (Loop variable renamed so it stops shadowing lf's own $f.)
# `file` is from the `file` package, listed as a dependency in
# apt-packages.txt, but not guaranteed on minimal installs. Swallow its
# stderr so a missing `file` degrades predictably: everything falls into
# the `*)` opener branch instead of printing an error and doing weird
# things on every open.
# `OPENER` is only exported by .zshrc, so lf launched from a desktop
# launcher, a script, or a non-interactive shell (tmux run-shell /
# display-popup -E) gets OPENER="" and every non-text open silently does
# nothing. Resolve a per-OS default here instead of trusting the
# environment: xdg-open on Linux, `open` on macOS.
# `readlink -f` is GNU-only: macOS's BSD readlink has no -f. Prefer the
# coreutils greadlink (Brewfile installs coreutils) when present, fall back
# to GNU readlink on Linux, else leave the path untouched.
cmd open ${{
    test -L $f && f=$(command -v greadlink >/dev/null 2>&1 && greadlink -f "$f" || readlink -f "$f" 2>/dev/null || printf '%s' "$f")
    opener=${OPENER:-}
    [ -n "$opener" ] || opener=$(command -v xdg-open >/dev/null 2>&1 && echo xdg-open || echo open)
    case $(file --mime-type "$f" -b 2>/dev/null) in
        text/*) $EDITOR $fx;;
        *)  for target in $fx; do
                if command -v setsid >/dev/null 2>&1; then
                    setsid -f $opener "$target" >/dev/null 2>&1
                else
                    $opener "$target" >/dev/null 2>&1 &
                fi
            done;;
    esac
}}
