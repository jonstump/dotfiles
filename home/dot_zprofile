# Homebrew shellenv. On macOS prefer the prefix matching the arch of the
# current shell (Rosetta vs native arm64 — a Rosetta shell routing to
# /opt/homebrew is wrong per Homebrew's docs), falling back to the other one.
# On Linux (Bazzite/other atomic Fedora images) the repo's whole toolset comes
# from Linuxbrew at /home/linuxbrew/.linuxbrew, and nothing external is
# guaranteed to export HOMEBREW_PREFIX into every login shell — so probe it
# here too instead of relying on the image's own provisioning.
case "$(uname -s)" in
  Darwin)
    if [ "$(uname -m)" = "x86_64" ]; then
      for brew_bin in /usr/local/bin/brew /opt/homebrew/bin/brew; do
        if [ -x "$brew_bin" ]; then
          eval "$("$brew_bin" shellenv)"
          break
        fi
      done
    else
      for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$brew_bin" ]; then
          eval "$("$brew_bin" shellenv)"
          break
        fi
      done
    fi
    ;;
  Linux)
    if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
      eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    fi
    ;;
esac

# pyenv installs itself to ~/.pyenv (install.sh runs pyenv.run), but nothing
# put that on PATH — so `command -v pyenv` was always false and both
# `pyenv init` calls were permanently dead. ~/.local/bin doesn't cover it.
export PYENV_ROOT="$HOME/.pyenv"
if [ -d "$PYENV_ROOT/bin" ]; then
  export PATH="$PYENV_ROOT/bin:$PATH"
fi

command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init --path)"

# `thefuck --alias` is a Python interpreter startup on every shell. Define the
# alias lazily so that cost is only paid if you actually use it.
if command -v thefuck >/dev/null 2>&1; then
  fuck() {
    unset -f fuck
    eval "$(thefuck --alias)"
    fuck "$@"
  }
fi
