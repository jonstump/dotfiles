# Identity is deliberately NOT tracked here — this repo is public. Put it in
# ~/.gitconfig.local, which the include below picks up:
#
#   [user]
#       name = Your Name
#       email = you@example.com
#
# Without that file, `git commit` fails with "Please tell me who you are" on
# a fresh machine. chezmoi doesn't manage ~/.gitconfig.local at all — it's
# untracked on every machine, same as before this repo moved to chezmoi.
[include]
	path = ~/.gitconfig.local

# git-delta is installed by both Brewfile and apt-packages.txt, but it only
# does anything once it's wired up as git's pager.
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[merge]
	# diff3, not zdiff3: zdiff3 needs git >= 2.35 (Jan 2022), but this repo
	# installs git from apt on Debian 11 / Ubuntu 20.04 / 22.04, which ship
	# 2.30 / 2.25 / 2.34. There, a conflicted merge/pull dies with
	# "fatal: unknown conflict style 'zdiff3'". diff3 works everywhere and
	# still shows all three sides (ours / base / theirs).
	conflictstyle = diff3

[init]
	defaultBranch = main

[pull]
	ff = only
