# Mac App Store entries, split out of the main Brewfile.
#
# `mas` can only install titles already associated with the signed-in Apple ID
# — it can't purchase, and on modern macOS it can't sign in either. On a brand
# new machine that hasn't been signed into the App Store, every one of these
# fails. Since `brew bundle` aborts the whole run on a hard error, keeping them
# in the main Brewfile put the entire install at their mercy.
#
# So: sign in to the App Store first, then run this by hand:
#
#     brew bundle --file=Brewfile.mas
#
# NOTE: "Delicious Library 3" was pulled from the App Store. Verify with
# `mas info 635124250` before relying on it.

mas "1Blocker", id: 1365531024
mas "ColorSlurp", id: 1287239339
mas "Delicious Library 3", id: 635124250
